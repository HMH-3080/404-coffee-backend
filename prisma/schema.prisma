// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int        @id @default(autoincrement())
  name         String
  passwordHash String
  position     String
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  pagePermissions   UserPagePermission[]
  actionPermissions UserActionPermission[]

  @@map("users")
}

model UserPagePermission {
  id      Int     @id @default(autoincrement())
  userId  Int
  page    String
  enabled Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, page])
  @@map("user_page_permissions")
}

model UserActionPermission {
  id      Int     @id @default(autoincrement())
  userId  Int
  page    String
  action  String
  enabled Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, page, action])
  @@map("user_action_permissions")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model RawMaterial {
  id              Int     @id @default(autoincrement())
  name            String  @unique
  unit            String
  supplier        String
  minStockAlert   Decimal @db.Decimal(12, 2)
  expiryAlertDays Int?

  addedAt   DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batches RawMaterialBatch[]

  productTypeIngredients ProductTypeIngredient[]
  productSizeIngredients ProductSizeIngredient[]

  purchaseItems PurchaseItem[]

  @@map("raw_materials")
}

model RawMaterialBatch {
  id            Int       @id @default(autoincrement())
  rawMaterialId Int
  quantity      Decimal   @db.Decimal(12, 2)
  pricePerUnit  Decimal   @db.Decimal(12, 2)
  expiryDate    DateTime?
  addedAt       DateTime  @default(now())

  rawMaterial RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rawMaterialId])
  @@index([expiryDate])
  @@map("raw_material_batches")
}

model Product {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  image       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  types  ProductType[]
  sizes  ProductSize[]
  addons ProductAddon[]

  saleItems SaleItem[]

  @@map("products")
}

model ProductType {
  id        Int    @id @default(autoincrement())
  productId Int
  name      String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  ingredients ProductTypeIngredient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, name])
  @@index([productId])
  @@map("product_types")
}

model ProductTypeIngredient {
  id            Int @id @default(autoincrement())
  productTypeId Int
  rawMaterialId Int

  productType ProductType @relation(fields: [productTypeId], references: [id], onDelete: Cascade)
  rawMaterial RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productTypeId, rawMaterialId])
  @@index([productTypeId])
  @@index([rawMaterialId])
  @@map("product_type_ingredients")
}

model ProductSize {
  id        Int    @id @default(autoincrement())
  productId Int
  typeName  String
  name      String

  basePrice  Decimal @db.Decimal(12, 2)
  finalPrice Decimal @db.Decimal(12, 2)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  ingredients ProductSizeIngredient[]
  saleItems   SaleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, typeName, name])
  @@index([productId])
  @@map("product_sizes")
}

model ProductSizeIngredient {
  id            Int @id @default(autoincrement())
  productSizeId Int
  rawMaterialId Int

  quantity Decimal @db.Decimal(12, 2)
  unit     String

  productSize ProductSize @relation(fields: [productSizeId], references: [id], onDelete: Cascade)
  rawMaterial RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productSizeId, rawMaterialId])
  @@index([productSizeId])
  @@index([rawMaterialId])
  @@map("product_size_ingredients")
}

model ProductAddon {
  id        Int    @id @default(autoincrement())
  productId Int
  name      String

  price Float
  notes String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, name])
  @@index([productId])
  @@map("product_addons")
}

model Supplier {
  id                    Int     @id @default(autoincrement())
  name                  String
  contactPerson         String
  phone                 String
  email                 String?
  country               String?
  city                  String
  address               String?
  taxRegistrationNumber String?
  supplierType          String
  supplierCategory      String
  paymentTerms          String?
  creditLimit           Decimal @default(0) @db.Decimal(12, 2)
  openingBalance        Decimal @default(0) @db.Decimal(12, 2)
  notes                 String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases Purchase[]

  @@map("suppliers")
}

enum PurchaseStatus {
  DRAFT
  APPROVED
  CANCELLED
}

model Purchase {
  id         Int    @id @default(autoincrement())
  invoiceNo  String @unique
  supplierId Int

  invoiceDate DateTime
  discount    Decimal  @default(0) @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(12, 2)
  finalTotal  Decimal  @db.Decimal(12, 2)

  status PurchaseStatus @default(DRAFT)

  supplier Supplier @relation(fields: [supplierId], references: [id])

  items PurchaseItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([invoiceDate])
  @@index([status])
  @@map("purchases")
}

model PurchaseItem {
  id Int @id @default(autoincrement())

  purchaseId    Int
  rawMaterialId Int

  quantity     Decimal @db.Decimal(12, 2)
  unit         String
  pricePerUnit Decimal @db.Decimal(12, 2)
  totalPrice   Decimal @db.Decimal(12, 2)

  purchase    Purchase    @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  rawMaterial RawMaterial @relation(fields: [rawMaterialId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([purchaseId])
  @@index([rawMaterialId])
  @@map("purchase_items")
}

model Sale {
  id        Int      @id @default(autoincrement())
  total     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items SaleItem[]

  @@map("sales")
}

model SaleItem {
  id            Int     @id @default(autoincrement())
  saleId        Int
  productId     Int
  productSizeId Int
  quantity      Decimal @db.Decimal(12, 2)
  unitPrice     Decimal @db.Decimal(12, 2)
  totalPrice    Decimal @db.Decimal(12, 2)

  sale        Sale        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id])
  productSize ProductSize @relation(fields: [productSizeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([saleId])
  @@index([productId])
  @@index([productSizeId])
  @@map("sale_items")
}
